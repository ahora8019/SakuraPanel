{
  "name": "sakurapanel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakurapanel",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SECURITY_KV",
      "id": "<SECURITY_KV_ID>"
    }
  ]

  // Configure AUTH_SECRET and BOOTSTRAP_SECRET using Wrangler secrets.
  // SECURITY_KV is required by the runtime; rate limiting is stored in D1.
}
