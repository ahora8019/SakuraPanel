{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakurapanel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakurapanel",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SECURITY_KV",
      "id": "<SECURITY_KV_ID>"
    }
  ]
}
