{
  "name": "sakurapanel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakurapanel",
      "database_id": "<D1_DATABASE_ID>"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "<RATE_LIMIT_KV_ID>"
    },
    {
      "binding": "SECURITY_KV",
      "id": "<SECURITY_KV_ID>"
    }
  ]
}
