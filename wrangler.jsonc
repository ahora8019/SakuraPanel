{
  "name": "sakurapanel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "account_id": "ff120baa3a2ca57960995ddabf610e95",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakurapanel",
      "database_id": "db7c0fc3-7e65-49c7-8005-a23fd9adbbfb",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SECURITY_KV",
      "id": "fdc01356fa8d48a8bbd375edc113441a"
    }
  ],
  "env": {
    "preview": {
      "name": "sakurapanel-preview",
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sakurapanel-preview-db",
          "database_id": "6c6916e8-37b3-4d2c-bd9b-2de0015fb904",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SECURITY_KV",
          "id": "1d211a09497940c286a3941182e8fe7d"
        }
      ]
    }
  }
}
